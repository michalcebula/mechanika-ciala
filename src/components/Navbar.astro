---
import { withBase } from '../lib/paths';
import {getContent} from '../lib/content';
const c = await getContent();
const booksyUrl = c.booksyUrl;
const path = Astro.url.pathname;
const isCurrentPage = (url: string) => path.replace(/\/$/, '') === url.replace(/\/$/, '');
const nav = [{url:'/',label:c.copy.shared.navHome},{url:'/#jak-pomagam',label:c.copy.shared.navHelp},{url:'/o-mnie/',label:c.copy.shared.navAbout},{url:'/kontakt/',label:c.copy.shared.navContact}].map(n => ({ ...n, url: withBase(n.url) }));
---
    <header class="header"><div class="shell nav-wrap">
      <a class="brand" href={withBase('/')} aria-label={`${c.name} — strona główna`}>{c.name}<span>{c.copy.shared.brandSubtitle}</span></a>
      <nav class="desktop-nav" aria-label="Menu główne">{nav.map(n=><a data-nav-link href={n.url} aria-current={isCurrentPage(n.url)?'page':undefined}>{n.label}</a>)}</nav>
      <a class="button nav-cta" href={booksyUrl} target="_blank" rel="noopener noreferrer">{c.copy.shared.navBookingLabel} <span aria-hidden="true">↗</span></a>
      <details class="mobile-menu"><summary>Menu</summary><nav aria-label="Menu mobilne">{nav.map(n=><a data-nav-link href={n.url} aria-current={isCurrentPage(n.url)?'page':undefined}>{n.label}</a>)}<a href={booksyUrl} target="_blank" rel="noopener noreferrer">{c.copy.shared.navBookingLabel} ↗</a></nav></details>
    </div></header>

<script>
  import { currentNavValue } from '../lib/navigation.mjs';

  function updateNavigation() {
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach(link => {
      const current = currentNavValue(link.href, window.location.href);
      if (current) link.setAttribute('aria-current', current);
      else link.removeAttribute('aria-current');
    });
  }

  updateNavigation();
  window.addEventListener('hashchange', updateNavigation);
  window.addEventListener('pageshow', updateNavigation);
  document.addEventListener('astro:page-load', updateNavigation);
  document.addEventListener('click', event => {
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest('.mobile-menu a');
    if (link) link.closest('details')?.removeAttribute('open');
  });
</script>
