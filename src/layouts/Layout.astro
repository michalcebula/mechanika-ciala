---
import SocialIcon from '../components/SocialIcon.astro';
import { withBase } from '../lib/paths';
import Navbar from '../components/Navbar.astro';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { getContent } from '../lib/content';
const c = await getContent();
const {title, description = c.heroDescription} = Astro.props;
const path = Astro.url.pathname;
const canonical = Astro.site ? new URL(path,Astro.site).href : undefined;
const ready = Boolean(Astro.site && c.privacyApproved);
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Mechanika Ciała</title><meta name="description" content={description} />
    <meta name="theme-color" content="#123c33" /><link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="robots" content={ready ? 'index,follow' : 'noindex,nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={`${title} | Mechanika Ciała`} /><meta property="og:description" content={description} />
    <meta property="og:type" content="website" /><meta property="og:locale" content="pl_PL" />
    {canonical && <meta property="og:url" content={canonical} />}
  </head>
  <body>
    <a class="skip" href="#tresc">Przejdź do treści</a>
    <Navbar booksyUrl={c.booksyUrl} />
    <main id="tresc"><slot /></main>
    <footer class="footer"><div class="shell">
      <div class="footer-top"><div><p class="eyebrow light">TWÓJ KOLEJNY KROK</p><h2>Zadbaj o swobodę ruchu.</h2></div><a class="button cream footer-booksy" href={c.booksyUrl} target="_blank" rel="noopener noreferrer"><img src={withBase('/images/booksy.png')} width="24" height="24" alt="" />Umów się przez Booksy</a></div>
      <div class="footer-bottom"><div class="brand">MECHANIKA CIAŁA<span>Kamil Szuwalski · Fizjoterapia</span></div><div><p>{c.location}</p>{c.address&&<p>{c.address}</p>}{c.phone&&<a href={`tel:${c.phone.replace(/\s/g,'')}`}>{c.phone}</a>}{c.email&&<a href={`mailto:${c.email}`}>{c.email}</a>}</div><div class="footer-links"><a href={c.facebookUrl} target="_blank" rel="noopener noreferrer"><SocialIcon name="facebook" />Facebook</a><a href={c.googleUrl} target="_blank" rel="noopener noreferrer"><SocialIcon name="map" />Google Maps</a><a href={withBase('/prywatnosc/')}>Prywatność i cookies</a></div></div>
      <div class="copyright">© {new Date().getFullYear()} Mechanika Ciała Kamil Szuwalski</div>
    </div></footer>
  </body>
</html>
