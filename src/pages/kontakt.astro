---
import { withBase } from '../lib/paths';
import SocialIcon from '../components/SocialIcon.astro';
import Layout from '../layouts/Layout.astro';
import {getContent} from '../lib/content';
const c = await getContent();
const phone = c.phone;
const email = c.email;
const address = c.address;
const mapUrl = `https://www.google.com/maps?q=${encodeURIComponent(`${c.location} ${address}`)}&z=16&output=embed`;
---
<Layout title={c.copy.contact.seoTitle} description={c.copy.contact.seoDescription}>
  <section class="shell contact-hub" aria-labelledby="contact-title">
    <div class="contact-heading">
      <p class="eyebrow">{c.copy.contact.eyebrow}</p>
      <h1 id="contact-title">{c.copy.contact.title}</h1>
    </div>
    <div class="contact-overview">
      <div class="contact-details">
        <div class="contact-person-row">
          <p class="contact-person">{c.person} <span>{c.copy.contact.personDescription}</span></p>
          <a class="button contact-booksy" href={c.booksyUrl} target="_blank" rel="noopener noreferrer"><img src={withBase('/images/booksy.png')} width="24" height="24" alt="" />{c.copy.shared.bookingLabel}</a>
        </div>
        <div class="contact-direct">
          <a hidden={!phone} href={`tel:${phone.replace(/\s/g, '')}`}><span class="contact-label">tel.</span><span>{phone}</span></a>
          <a hidden={!email} href={`mailto:${email}`}><span class="contact-label">e-mail:</span><span>{email}</span></a>
        </div>
        <div class="contact-socials">
          <a class="text-link" href={c.facebookUrl} target="_blank" rel="noopener noreferrer"><SocialIcon name="facebook" />Facebook</a>
          <a class="text-link" href={c.googleUrl} target="_blank" rel="noopener noreferrer"><SocialIcon name="map" />Google Maps</a>
        </div>

      </div>
      <div class="contact-location">
        <div class="contact-address"><p class="small-label">{c.copy.contact.locationLabel}</p><h2>{c.location}</h2><p>{address}</p></div>
        <iframe class="contact-map" title={`Mapa dojazdu do gabinetu Mechanika Ciała — ${address}`} src={mapUrl} width="600" height="230" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        <a class="text-link" href={c.googleUrl} target="_blank" rel="noopener noreferrer">{c.copy.contact.directionsLink}</a>
      </div>
    </div>
    <div class="contact-gallery" role="group" aria-label="Gabinet i praca z pacjentem">
      <img src={c.clinicImage} alt={c.copy.images.kontakt0} width="1080" height="810" loading="lazy" decoding="async" />
      <img src={c.heroImage} alt={c.copy.images.kontakt1} width="1000" height="1100" loading="lazy" decoding="async" />
      <img src={c.treatmentImage} alt={c.copy.images.kontakt2} width="1080" height="810" loading="lazy" decoding="async" />
    </div>
  </section>
</Layout>
