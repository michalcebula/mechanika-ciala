---
import { withBase } from '../lib/paths';
import SocialIcon from '../components/SocialIcon.astro';
import Layout from '../layouts/Layout.astro';
import {getContent, fallback} from '../lib/content';
const c = await getContent();
const phone = c.phone || fallback.phone;
const email = c.email || fallback.email;
const address = c.address || fallback.address;
const mapUrl = `https://www.google.com/maps?q=${encodeURIComponent(`XXS Gym ${address}`)}&z=16&output=embed`;
---
<Layout title="Kontakt i rezerwacja wizyty" description="Zadzwoń, napisz lub umów wizytę w Booksy. Kamil Szuwalski — Mechanika Ciała, XXS Gym, Zabłocie 24 w Krakowie.">
  <section class="shell contact-hub" aria-labelledby="contact-title">
    <div class="contact-heading">
      <p class="eyebrow">KONTAKT / KRAKÓW · ZABŁOCIE</p>
      <h1 id="contact-title">Porozmawiajmy.<br />Do zobaczenia w gabinecie.</h1>
    </div>
    <div class="contact-overview">
      <div class="contact-details">
        <div class="contact-person-row">
          <p class="contact-person">Kamil Szuwalski <span>Fizjoterapeuta · Mechanika Ciała</span></p>
          <a class="button contact-booksy" href={c.booksyUrl} target="_blank" rel="noopener noreferrer"><img src={withBase('/images/booksy.png')} width="24" height="24" alt="" />Umów w Booksy</a>
        </div>
        <div class="contact-direct">
          <a href={`tel:${phone.replace(/\s/g, '')}`}><span class="contact-label">tel.</span><span>{phone}</span></a>
          <a href={`mailto:${email}`}><span class="contact-label">e-mail:</span><span>{email}</span></a>
        </div>
        <div class="contact-socials">
          <a class="text-link" href={c.facebookUrl} target="_blank" rel="noopener noreferrer"><SocialIcon name="facebook" />Facebook</a>
          <a class="text-link" href={c.googleUrl} target="_blank" rel="noopener noreferrer"><SocialIcon name="map" />Google Maps</a>
        </div>

      </div>
      <div class="contact-location">
        <div class="contact-address"><p class="small-label">TU PRZYJMUJĘ</p><h2>{c.location}</h2><p>{address}</p></div>
        <iframe class="contact-map" title={`Mapa dojazdu do gabinetu Mechanika Ciała — ${address}`} src={mapUrl} width="600" height="230" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        <a class="text-link" href={c.googleUrl} target="_blank" rel="noopener noreferrer">Wyznacz trasę w Google Maps</a>
      </div>
    </div>
    <div class="contact-gallery" role="group" aria-label="Gabinet i praca z pacjentem">
      <img src={c.clinicImage} alt="Wnętrze gabinetu Mechanika Ciała w XXS Gym" width="1080" height="810" loading="lazy" decoding="async" />
      <img src={c.heroImage} alt="Kamil Szuwalski podczas terapii manualnej" width="1000" height="1100" loading="lazy" decoding="async" />
      <img src={withBase('/images/terapia-szyi.jpg')} alt="Indywidualna praca z pacjentką w gabinecie" width="1080" height="810" loading="lazy" decoding="async" />
    </div>
  </section>
</Layout>
