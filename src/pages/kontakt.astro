---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import {getContent} from '../lib/content';
const c = await getContent();
---
<Layout title="Kontakt i rezerwacja wizyty" description="Umów wizytę u Kamila Szuwalskiego przez Booksy. Mechanika Ciała, XXS Gym, Kraków Zabłocie.">
  <section class="shell contact-intro"><p class="eyebrow">KONTAKT / UMÓW WIZYTĘ</p><h1>Zrób pierwszy krok<br />do swobodnego ruchu.</h1></section>
  <section class="shell booking-grid"><div class="booking"><p class="eyebrow">REZERWACJA ONLINE</p><h2>Twój termin.<br />Twój pierwszy krok.</h2><p class="lead">Aktualne terminy, dostępne usługi i ceny znajdziesz w Booksy.</p><a class="button" href={c.booksyUrl} target="_blank" rel="noopener noreferrer">Wybierz termin w Booksy <span aria-hidden="true">↗</span></a><p class="muted">Rezerwację dokończysz w serwisie Booksy.</p></div><div class="contact-card"><div><p class="eyebrow">GABINET</p><h3>{c.location}</h3>{c.address&&<p>{c.address}</p>}{c.phone&&<p><a href={`tel:${c.phone.replace(/\s/g,'')}`}>{c.phone}</a></p>}{c.email&&<p><a href={`mailto:${c.email}`}>{c.email}</a></p>}</div><img src={withBase('/images/terapia-szyi.jpg')} alt="Kamil Szuwalski pracujący z pacjentką w gabinecie" width="1080" height="810" loading="lazy" /></div></section>
  <section class="section shell location-grid"><img src={c.clinicImage} alt="Gabinet fizjoterapii w XXS Gym" width="1080" height="810" loading="lazy" /><div><p class="eyebrow">KRAKÓW · ZABŁOCIE</p><h2>Do zobaczenia<br />w gabinecie.</h2><p class="lead">Przyjmuję w XXS Gym na Zabłociu. Sprawdź lokalizację i zaplanuj dojazd.</p><a class="button outline" href={c.googleUrl} target="_blank" rel="noopener noreferrer">Otwórz mapę Google ↗</a><a class="text-link" href={c.facebookUrl} target="_blank" rel="noopener noreferrer">Mechanika Ciała na Facebooku ↗</a></div></section>
</Layout>
