---
import SocialIcon from '../components/SocialIcon.astro';
import Layout from '../layouts/Layout.astro';
import {getContent, fallback} from '../lib/content';
const c = await getContent();
const phone = c.phone || fallback.phone;
const email = c.email || fallback.email;
const address = c.address || fallback.address;
const mapUrl = `https://www.google.com/maps?q=${encodeURIComponent(`XXS Gym ${address}`)}&z=16&output=embed`;
---
<Layout title="Kontakt i rezerwacja wizyty" description="Zadzwoń, napisz lub umów wizytę w Booksy. Kamil Szuwalski — Mechanika Ciała, XXS Gym, Zabłocie 24 w Krakowie.">
  <section class="shell contact-hub" aria-labelledby="contact-title">
    <div class="contact-heading">
      <p class="eyebrow">KONTAKT / KRAKÓW · ZABŁOCIE</p>
      <h1 id="contact-title">Porozmawiajmy.<br />Do zobaczenia w gabinecie.</h1>
    </div>
    <div class="contact-overview">
      <div class="contact-details">
        <p class="contact-person">Kamil Szuwalski <span>Fizjoterapeuta · Mechanika Ciała</span></p>
        <div class="contact-direct">
          <a href={`tel:${phone.replace(/\s/g, '')}`}><span class="small-label">ZADZWOŃ</span><strong>{phone}</strong><span class="contact-arrow" aria-hidden="true">↗</span></a>
          <a href={`mailto:${email}`}><span class="small-label">NAPISZ</span><strong>{email}</strong><span class="contact-arrow" aria-hidden="true">↗</span></a>
        </div>
        <div class="contact-socials">
          <a class="text-link" href={c.facebookUrl} target="_blank" rel="noopener noreferrer"><SocialIcon name="facebook" />Facebook <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={c.googleUrl} target="_blank" rel="noopener noreferrer"><SocialIcon name="map" />Google Maps <span aria-hidden="true">↗</span></a>
        </div>
        <div class="contact-reservation">
          <a class="button" href={c.booksyUrl} target="_blank" rel="noopener noreferrer">Umów wizytę w Booksy <span aria-hidden="true">↗</span></a>
          <p>Wybierz usługę i dogodny termin online.</p>
        </div>
      </div>
      <div class="contact-location">
        <div class="contact-address"><p class="small-label">TU PRZYJMUJĘ</p><h2>{c.location}</h2><p>{address}</p></div>
        <iframe class="contact-map" title={`Mapa dojazdu do gabinetu Mechanika Ciała — ${address}`} src={mapUrl} width="600" height="230" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        <a class="text-link" href={c.googleUrl} target="_blank" rel="noopener noreferrer">Wyznacz trasę w Google Maps <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</Layout>
