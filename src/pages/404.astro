---
import { withBase } from '../lib/paths';
import {getContent} from '../lib/content';
const c = await getContent();
import Layout from '../layouts/Layout.astro';
---
<Layout title={c.copy.notFound.seoTitle}><section class="shell section prose"><p class="eyebrow">404</p><h1>{c.copy.notFound.title}</h1><p>{c.copy.notFound.description}</p><a class="button" href={withBase('/')}>{c.copy.notFound.backLabel}</a></section></Layout>
