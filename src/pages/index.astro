---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import {getContent} from '../lib/content';
const c = await getContent();
const reviewCount = Number(c.reviewCount);
const rating = Number(String(c.rating).replace(',', '.'));
const hasBooksyRating = Number.isFinite(rating) && rating > 0 && rating <= 5 && Number.isInteger(reviewCount) && reviewCount > 0;
const reviewWord = reviewCount === 1 ? 'opinia' : new Intl.PluralRules('pl').select(reviewCount) === 'few' ? 'opinie' : 'opinii';
const ratingLabel = rating.toLocaleString('pl-PL', {minimumFractionDigits: 1, maximumFractionDigits: 1});
---
<Layout title={c.copy.home.seoTitle}>
  <section class="hero shell"><div class="hero-copy"><p class="eyebrow">{c.copy.home.eyebrow}</p><h1>{c.heroTitle.split('\n').map(line=><span>{line}</span>)}</h1><div class="accent-line"></div><p class="lead">{c.heroDescription}</p><div class="actions"><a class="button hero-booksy" href={c.booksyUrl} target="_blank" rel="noopener noreferrer"><img src={withBase('/images/booksy.png')} width="24" height="24" alt="" />{c.copy.shared.bookingLabel}</a><a class="text-link hero-approach-link" href="#jak-pomagam">{c.copy.home.approachLink}</a></div><p class="hero-caption">{c.person} <span>{c.copy.home.profession}</span></p></div><div class="hero-photo"><img src={c.portraitImage} alt={c.copy.images.index1} width="1000" height="1100" fetchpriority="high" /><span class="photo-label">{c.copy.home.photoLabel}</span></div></section>
  <div class="trust"><div class="shell trust-inner">
    <span class="small-label">{c.copy.home.trustLabel}</span>
    <span>{c.copy.home.clinicLabel}</span>
    <a class="booksy-rating" href={c.booksyUrl} target="_blank" rel="noopener noreferrer" aria-label={hasBooksyRating ? `Ocena ${ratingLabel} na 5, ${reviewCount} ${reviewWord}. Przeczytaj opinie na Booksy` : 'Poznaj opinie pacjentów na Booksy'}>
      {hasBooksyRating ? <><svg class="rating-star" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.76 5.82 21 7 14.14 2 9.27l6.91-1.01Z" /></svg><strong>{ratingLabel} <small>/ 5</small></strong><span class="rating-count">{reviewCount} {reviewWord} na Booksy</span></> : 'Poznaj opinie pacjentów na Booksy'}
    </a>
  </div></div>
  <section class="section shell help-section" id="jak-pomagam" aria-labelledby="help-title">
    <div class="help-intro">
      <div><p class="eyebrow">{c.copy.home.helpLabel}</p><h2 id="help-title">{c.copy.home.helpTitle}</h2></div>
      <div class="help-copy">{c.copy.home.helpParagraphs.map(p=><p>{p}</p>)}</div>
    </div>
    <div class="service-grid">{c.services.map((s,i)=><a class="service" href={withBase('/kontakt/')} aria-label={`${s.title} — przejdź do kontaktu`}><span class="number">0{i+1}</span><h3>{s.title}</h3><p>{s.description}</p></a>)}</div>
  </section>
  <section class="approach cooperation" aria-labelledby="cooperation-title">
    <div class="shell approach-grid">
      <div><p class="eyebrow light">{c.copy.home.cooperationLabel}</p><h2 id="cooperation-title">{c.copy.home.cooperationTitle}</h2><a class="text-link" href={withBase('/kontakt/')}>{c.copy.home.cooperationLink} <span aria-hidden="true">↗</span></a></div>
      <div class="cooperation-copy">{c.copy.home.cooperationParagraphs.map(p=><p>{p}</p>)}</div>
    </div>
    {c.trainers.length > 0 && <div class="shell trainer-grid">{c.trainers.map(trainer =>
      <article class="trainer-card">
        <img src={trainer.image} alt={`Zdjęcie: ${trainer.name}`} width="720" height="520" loading="lazy" decoding="async" />
        <div class="trainer-details">
          <div><h3>{trainer.name}</h3><p>{trainer.qualification}</p><p>{trainer.role}</p></div>
          <a class="trainer-instagram" href={trainer.instagramUrl} target="_blank" rel="noopener noreferrer" aria-label={`Instagram — ${trainer.name}`}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/><circle cx="17.4" cy="6.8" r="1" fill="currentColor"/></svg>
            <span>Instagram</span>
          </a>
        </div>
      </article>
    )}</div>}
  </section>
  <section class="section shell about-teaser"><img src={c.heroImage} alt={c.copy.images.index0} width="600" height="680" loading="lazy" /><div><p class="eyebrow">{c.copy.home.aboutLabel}</p><h2>{c.copy.home.aboutTitle}</h2><p class="lead">{c.biography[0]}</p><a class="text-link" href={withBase('/o-mnie/')}>{c.copy.home.aboutLink} <span aria-hidden="true">↗</span></a></div></section>
  <section class="section shell reviews"><div class="section-heading"><div><p class="eyebrow">{c.copy.home.reviewsLabel}</p><h2>{c.copy.home.reviewsTitle}</h2></div><a class="text-link" href={c.booksyUrl} target="_blank" rel="noopener noreferrer">{c.copy.home.reviewsLink}</a></div>{c.reviews.length>0&&<div class="reviews-grid">{c.reviews.map(r=><blockquote><p>„{r.text}”</p><cite>{r.name}</cite></blockquote>)}</div>}</section>
</Layout>
