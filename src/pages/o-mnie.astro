---
import Layout from '../layouts/Layout.astro';
import {getContent} from '../lib/content';
const c = await getContent();
---
<Layout title={c.copy.about.seoTitle} description={c.copy.about.seoDescription}>
  <section class="hero about-hero shell">
    <div class="hero-copy">
      <p class="eyebrow">{c.copy.about.eyebrow}</p>
      <h1>{c.aboutTitle.split('\n').map(line=><span>{line}</span>)}</h1>
      <div class="accent-line"></div>
      <div class="about-introduction">{c.biography.map(p=><p>{p}</p>)}</div>
    </div>
    <div class="hero-photo"><img src={c.portraitImage} alt={c.copy.images.o_mnie0} width="900" height="1100" fetchpriority="high" /></div>
  </section>
  <section class="shell values">{c.copy.about.values.map((v,i)=><article><span class="big-number">0{i+1}</span><h3>{v.title}</h3><p>{v.text}</p></article>)}</section>
  {c.credentials.length>0&&<section class="section shell"><p class="eyebrow">{c.copy.about.credentialsLabel}</p><h2>{c.copy.about.credentialsTitle}</h2><div class="credentials">{c.credentials.map(item=><article><span>{item.year}</span><h3>{item.title}</h3><p>{item.institution}</p></article>)}</div></section>}
  <section class="section shell gallery"><img src={c.heroImage} alt={c.copy.images.o_mnie1} width="900" height="800" loading="lazy" /><img src={c.clinicImage} alt={c.copy.images.o_mnie2} width="1080" height="810" loading="lazy" /></section>
</Layout>
